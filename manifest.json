{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "2.6.15.25",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "rovalra-custom-port@raviannaivar.com",
      "update_url": "https://raw.githubusercontent.com/raviannaivar/RVFFP/main/updates.json"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.roblox.com/*"
      ],
      "js": [
        "firefox-event-replay.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.roblox.com/*"
      ],
      "js": [
        "intercept.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.roblox.com/*"
      ],
      "js": [
        "public/Assets/data/serverid_extractor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.roblox.com/*"
      ],
      "js": [
        "draco_decoder.js",
        "content.js"
      ],
      "css": [
        "css/sitewide.css",
        "css/rovalra.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "scripting",
    "contextMenus",
    "webNavigation"
  ],
  "host_permissions": [
    "https://games.roblox.com/*",
    "*://*.roblox.com/*",
    "https://gamejoin.roblox.com/v1/join-game-instance",
    "https://users.roblox.com/*",
    "*://*.rovalra.com/*"
  ]
}
